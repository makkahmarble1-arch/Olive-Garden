# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# Site URL, no trailing slash. Local: http://localhost:3000.
# Vercel Production: https://olivegardenmenuprices.us (owner decision 2026-11-13).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing switch. Leave unset (= off: every page noindex,
# empty sitemap) until launch. Set SITE_INDEXING=true ONLY in Vercel
# Production after owner approval (docs/LAUNCH_CHECKLIST.md).
# SITE_INDEXING=true

# Supabase (Project Settings > API Keys). Only the PUBLISHABLE key goes here.
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SERVER ONLY (no NEXT_PUBLIC_ prefix). Supabase secret key for the rating
# vote API (Project Settings > API Keys > Secret keys). Never expose it.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# SERVER ONLY. Random secret (32+ characters) for anonymous visitor hashes.
# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later lets every visitor vote again, so keep it stable.
RATING_HASH_SECRET=replace_with_a_long_random_value
